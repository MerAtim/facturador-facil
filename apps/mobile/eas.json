{
  "cli": {
    "version": ">= 27.1.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "base": {
      "node": "24.22.1",
      "pnpm": "10.34.6"
    },
    "desarrollo": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": { "buildType": "apk" }
    },
    "prueba": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" }
    },
    "punta_a_punta": {
      "extends": "base",
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_DOBLE_DE_ARCA": "si" },
      "android": { "buildType": "apk" }
    },
    "produccion": {
      "extends": "base",
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "produccion": {}
  }
}
